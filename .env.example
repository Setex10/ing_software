# Copia este archivo a .env.local y ajusta los valores.
# La app corre sin estas variables (usa valores de desarrollo por defecto),
# pero deben definirse antes de cualquier despliegue real.

# Secreto usado para firmar y verificar el JWT de sesión (lib/auth.js).
# Genera uno propio, por ejemplo con: openssl rand -base64 32
JWT_SECRET=cambia-este-valor-por-un-secreto-aleatorio-largo

# Duración del token de sesión (formato aceptado por la librería "jsonwebtoken").
JWT_EXPIRES_IN=8h

# Puerto en el que escucha la app (usado por docker-compose.yml).
PORT=3000
