# Copia este archivo como ".env.local" y reemplaza los valores reales.
# ".env.local" NUNCA se sube a git (ya está en .gitignore).

# Cadena de conexión a tu base de datos MongoDB (Atlas o local)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/nombre_de_tu_db

# Secreto usado para firmar y verificar los JWT de sesión (login)
# Genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplaza_esto_por_un_secreto_largo_y_aleatorio
